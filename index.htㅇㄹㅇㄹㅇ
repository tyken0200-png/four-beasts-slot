 .navtitle{display:none}
 .nav{white-space:nowrap;width:auto;border:0;padding:9px 11px}
 .nav.active{border-bottom:2px solid #777}
 .page{padding:14px}
 .grid,.marketgrid{grid-template-columns:1fr}
 .live{height:300px}
 .chat{height:310px}
 #chat{height:268px}
}
</style>
</head>

