<script>
const $=id=>document.getElementById(id);

let session=Math.random().toString(36).slice(2,10).toUpperCase();
$("session").textContent=session;
$("rSession").textContent=session;

let audioCtx=null;

function sound(freq=180,duration=.08,type="sine"){
 try{
  if(!audioCtx) audioCtx=new(window.AudioContext||window.webkitAudioContext)();
  const o=audioCtx.createOscillator();
  const g=audioCtx.createGain();
  o.type=type;o.frequency.value=freq;
  g.gain.setValueAtTime(.035,audioCtx.currentTime);
  g.gain.exponentialRampToValueAtTime(.001,audioCtx.currentTime+duration);
  o.connect(g);g.connect(audioCtx.destination);
  o.start();o.stop(audioCtx.currentTime+duration);
 }catch(e){}
}

function toast(t){
 const x=document.createElement("div");
 x.className="toast";
 x.textContent=t;
 $("toast").appendChild(x);
 setTimeout(()=>x.remove(),3500);
}

function go(page){
 sound(150,.06);
 document.querySelectorAll(".page").forEach(x=>x.classList.remove("active"));
 document.querySelectorAll(".nav").forEach(x=>x.classList.remove("active"));

 $(page).classList.add("active");
 document.querySelector(`[data-page="${page}"]`).classList.add("active");

 if(page==="live")startLive();
 if(page==="unknown")unknown();
 if(page==="exit")toast("SESSION REMAINS ACTIVE");
}

document.querySelectorAll(".nav").forEach(btn=>{
 btn.onclick=()=>go(btn.dataset.page);
});

/* BOOT */
const lines=[
"initializing relay...",
"checking node integrity...",
"loading encrypted directory...",
"connecting to private relay...",
"session watcher: active",
"camera channel: available",
"archive index: corrupted",
"unknown node detected.",
"connection established."
];

let li=0;

const bootTimer=setInterval(()=>{
 if(li<lines.length){
  $("log").innerHTML+=lines[li]+"<br>";
  $("bar").style.width=((li+1)/lines.length*100)+"%";
  li++;
 }else{
  clearInterval(bootTimer);
  $("enter").style.display="inline-block";
 }
},420);

$("enter").onclick=()=>{
 $("boot").style.display="none";
 $("app").style.display="block";
 sound(80,.3,"sawtooth");
 toast("SESSION "+session+" CONNECTED");
};

/* LIVE CHAT */
const phrases=[
"WHO IS THIS",
"new visitor",
"HE FOUND IT",
"don't answer",
"where are you from",
"korea?",
"someone tell him to leave",
"WE CAN SEE YOU",
"why is he still here",
"NEW SESSION",
"check the archive",
"STREAM 07",
"don't open 03:14",
"too late",
"who sent the link",
"he is still connected",
"IS THAT HIM",
"wait",
"look at the viewer count",
"there are two sessions",
"NO THERE ARE THREE",
"don't type anything",
"leave the window open",
"who invited him",
"NEW USER DETECTED",
"can you see the camera",
"he can see us",
"this wasn't here yesterday",
"someone is typing",
"STOP",
"UNKNOWN:",
"hello."
];

let liveStarted=false;
let liveSeconds=0;
let chatCount=0;

function startLive(){
 if(liveStarted)return;
 liveStarted=true;

 const start=Date.now();

 const timer=setInterval(()=>{
  liveSeconds=Math.floor((Date.now()-start)/1000);

  $("timer").textContent=
   "00:"+String(Math.min(liveSeconds,59)).padStart(2,"0");

  let v=1284+
   Math.floor(liveSeconds*(
    8+Math.random()*20
   ));

  if(liveSeconds>20)v+=Math.floor(Math.random()*400);

  $("viewers").textContent=v.toLocaleString();
  $("homeview").textContent=v.toLocaleString();

  if(liveSeconds===4){
   $("camtext").textContent="SIGNAL IS WATCHING";
   toast("UNKNOWN NODE CONNECTED");
  }

  if(liveSeconds===12){
   $("camtext").textContent="WHO ARE YOU?";
   document.body.classList.add("glitch");
   setTimeout(()=>document.body.classList.remove("glitch"),150);
  }

  if(liveSeconds===22){
   $("camtext").textContent="YOUR SESSION HAS BEEN LOGGED";
   toast("SESSION WATCHER ACTIVE");
  }

  if(liveSeconds>=30){
   clearInterval(timer);
   $("camtext").textContent="WE KNOW YOU ARE HERE";
   addMsg("UNKNOWN","you have been here for 00:30",true);
  }

 },1000);

 const chatTimer=setInterval(()=>{
  if(liveSeconds>=30){
   clearInterval(chatTimer);
   return;
  }

  const name=
   Math.random()<.08 ? "UNKNOWN" :
   "anon_"+Math.random().toString(36).slice(2,7);

  let text=phrases[Math.floor(Math.random()*phrases.length)];

  if(Math.random()<.18)
   text=text+".";

  addMsg(name,text,name==="UNKNOWN");

 },Math.random()*400+180);
}

function addMsg(name,text,unknown=false){
 const div=document.createElement("div");
 div.className="msg"+(unknown?" unk":"");
 div.innerHTML="<strong>"+name+":</strong> "+text;

 $("chat").appendChild(div);
 chatCount++;
 $("chatcount").textContent=chatCount;

 while($("chat").children.length>55)
   $("chat").firstChild.remove();

 sound(70+Math.random()*80,.025);
}

/* MARKET */
function fakeOrder(btn){
 sound(90,.12,"square");
 btn.disabled=true;

 const old=btn.textContent;
 btn.textContent="PROCESSING...";

 setTimeout(()=>{
  btn.textContent="ORDER FAILED";

  toast("ORDER REJECTED // UNKNOWN USER");

  setTimeout(()=>{
   btn.textContent=old;
   btn.disabled=false;
  },2500);
 },1200);
}

/* SEARCH */
function search(){
 const q=$("query").value.trim().toLowerCase();
 sound(180,.07);

 if(!q){
  $("result").textContent="NO QUERY.";
  return;
 }

 if(q==="me"||q==="myself"||q==="you"){
  $("result").innerHTML=
   "1 RESULT FOUND<br><br>"+
   "USER_████████<br>"+
   "STATUS: <b>ONLINE</b><br>"+
   "SOURCE: CURRENT SESSION<br>"+
   "NODE: 07<br>"+
   "LAST SEEN: NOW";

  toast("SEARCH RESULT ADDED AFTER QUERY");
 }else if(q==="exit"){
  $("result").innerHTML=
   "0 RESULTS<br><br>"+
   "...<br><br>"+
   "WAIT.<br><br>"+
   "1 RESULT ADDED.";
 }else{
  $("result").innerHTML=
   "SEARCH COMPLETE<br>"+
   "RESULTS: 0<br><br>"+
   "INDEX STATUS: CORRUPTED";
 }
}

/* UNKNOWN */
function unknown(){
 const arr=[
  "WHO ARE YOU?",
  "WHY DID YOU COME HERE?",
  "WE SAW YOUR SESSION.",
  "YOU OPENED THE CAMERA.",
  "YOU SEARCHED THE ARCHIVE.",
  "YOU ARE STILL HERE.",
  "DON'T CLOSE THE WINDOW."
 ];

 let i=0;

 const t=setInterval(()=>{
  $("unknownText").textContent=arr[i++];
  sound(55,.1);

  if(i>=arr.length)clearInterval(t);
 },1400);
}

/* EXIT */
function attemptExit(){
 sound(45,.2,"sawtooth");

 $("exittext").innerHTML=
  "CLOSING SESSION...<br>"+
  "████████████████ 100%";

 setTimeout(()=>{
  $("exittext").innerHTML=
   "SESSION CLOSED.<br><br>...";

  setTimeout(()=>{
   $("exittext").innerHTML=
    "CONNECTION RESTORED.<br><br>"+
    "WELCOME BACK.<br><br>"+
    "LAST VISITOR: YOU";
   toast("CONNECTION RESTORED");
  },2200);

 },1600);
}

