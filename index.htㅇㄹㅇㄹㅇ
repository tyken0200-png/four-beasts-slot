<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>NODE_07</title>

<style>
*{box-sizing:border-box}
html,body{margin:0;background:#030404;color:#b9c0be;font-family:monospace}
body{min-height:100vh;overflow-x:hidden}

body:before{
 content:"";position:fixed;inset:0;pointer-events:none;z-index:9999;
 background:repeating-linear-gradient(0deg,transparent 0 3px,
 rgba(255,255,255,.025) 4px);
}
body:after{
 content:"";position:fixed;inset:0;pointer-events:none;z-index:9998;
 background:radial-gradient(circle,transparent 40%,rgba(0,0,0,.75));
}

button,input{font:inherit}
button{cursor:pointer}

#boot{
 position:fixed;inset:0;background:#020303;z-index:10000;
 display:flex;align-items:center;justify-content:center;padding:25px
}
.bootbox{width:min(700px,100%)}
.boottitle{font-size:30px;letter-spacing:7px;color:#ddd;margin-bottom:25px}
#log{height:210px;color:#596360;font-size:12px;line-height:1.9}
.progress{height:2px;background:#111}
.progress i{display:block;width:0;height:100%;background:#aaa}
#enter{
 display:none;margin-top:25px;background:#080a0a;color:#aaa;
 border:1px solid #444;padding:13px 25px
}

#app{display:none}

header{
 height:58px;border-bottom:1px solid #181f1f;
 display:flex;justify-content:space-between;align-items:center;
 padding:0 18px;position:sticky;top:0;z-index:100;
 background:rgba(3,5,5,.95);backdrop-filter:blur(8px)
}
.logo{letter-spacing:3px;color:#ddd;font-size:13px}
.topstatus{font-size:10px;color:#596360}

.layout{
 max-width:1450px;margin:auto;display:grid;
 grid-template-columns:200px 1fr 250px;min-height:calc(100vh - 58px)
}

aside{border-right:1px solid #181f1f;padding:15px 10px}
.right{border-left:1px solid #181f1f;padding:15px}

.navtitle,.sidetitle{
 color:#46504e;font-size:10px;letter-spacing:2px;margin-bottom:10px
}
.nav{
 width:100%;display:block;text-align:left;background:transparent;
 border:0;color:#697370;padding:11px;border-left:2px solid transparent
}
.nav:hover,.nav.active{background:#090c0c;color:#ddd;border-left-color:#777}

main{min-width:0}
.page{display:none;padding:25px;animation:fade .3s}
.page.active{display:block}
@keyframes fade{from{opacity:0;transform:translateY(5px)}to{opacity:1}}

h1{font-size:clamp(24px,5vw,42px);letter-spacing:4px;color:#e0e5e3;margin:0 0 7px}
.sub{font-size:10px;color:#505a57;margin-bottom:22px}

.hero{
 min-height:350px;border:1px solid #171e1e;
 display:flex;flex-direction:column;align-items:center;justify-content:center;
 text-align:center;background:radial-gradient(circle,#121919,#030505 65%);
 position:relative;overflow:hidden
}
.hero:before{
 content:"";position:absolute;width:240px;height:240px;border:1px solid #222;
 border-radius:50%;animation:pulse 3s infinite
}
@keyframes pulse{50%{transform:scale(1.15);opacity:.2}}
.hero h2{position:relative;font-size:clamp(27px,6vw,58px);letter-spacing:8px;margin:0}
.hero p{position:relative;color:#505b58;font-size:10px}
.big{
 position:relative;margin-top:25px;padding:13px 22px;
 color:#aaa;background:#070909;border:1px solid #343c3c
}
.big:hover{background:#ddd;color:#000}

.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-top:14px}
.card{
 border:1px solid #181f1f;background:#070909;padding:16px;cursor:pointer
}
.card:hover{border-color:#555}
.card b{display:block;color:#c8cfcd;margin-bottom:9px}
.card small{color:#505a57;line-height:1.8}

.panel{border:1px solid #181f1f;background:#060808;margin-bottom:15px}
.panelhead{
 padding:12px;border-bottom:1px solid #181f1f;
 display:flex;justify-content:space-between;font-size:10px;color:#68716f
}
.panelbody{padding:14px}

/* LIVE */
.live{
 height:390px;border:1px solid #252c2c;
 position:relative;overflow:hidden;
 background:
 radial-gradient(circle at 50% 50%,#151b1b,#030505 65%)
}
.noise{
 position:absolute;inset:0;opacity:.13;
 background:repeating-linear-gradient(90deg,
 transparent 0 5px,#fff 6px,transparent 7px 12px);
 animation:noise .08s infinite
}
@keyframes noise{
 25%{transform:translate(2px,-1px)}
 50%{transform:translate(-2px,2px)}
 75%{transform:translate(1px,1px)}
}
.livebadge{position:absolute;top:12px;left:12px;font-size:10px}
.livebadge i{
 display:inline-block;width:7px;height:7px;border-radius:50%;
 background:#aaa;margin-right:5px;animation:blink 1s infinite
}
@keyframes blink{50%{opacity:.15}}
.viewers{position:absolute;right:12px;top:12px;font-size:10px}
.cammsg{
 position:absolute;inset:0;display:flex;flex-direction:column;
 justify-content:center;align-items:center;text-align:center
}
.camicon{
 width:120px;height:75px;border:1px solid #343d3d;margin-bottom:17px;
 position:relative
}
.camicon:after{
 content:"";width:20px;height:20px;border:1px solid #68716f;
 border-radius:50%;position:absolute;left:50%;top:50%;
 transform:translate(-50%,-50%)
}
.cammsg span{font-size:10px;color:#707a77;letter-spacing:2px}

.chat{height:350px;border:1px solid #181f1f;background:#040606}
.chathead{height:40px;border-bottom:1px solid #181f1f;padding:12px;font-size:10px}
#chat{height:308px;padding:8px;display:flex;flex-direction:column;justify-content:flex-end;overflow:hidden}
.msg{font-size:10px;line-height:1.65;color:#6f7976;animation:msg .12s}
.msg strong{color:#a5aeab}
.msg.unk{color:#d4dad8}
@keyframes msg{from{opacity:0;transform:translateX(8px)}to{opacity:1}}

.search{display:flex;gap:7px}
.search input{
 flex:1;background:#060808;border:1px solid #222a29;
 color:#ddd;padding:12px;outline:0
}
.search button,.buy{
 background:#080b0b;border:1px solid #303737;color:#999;padding:10px 15px
}
.result{
 margin-top:12px;border:1px solid #181f1f;padding:16px;
 min-height:110px;color:#858f8c;font-size:11px;line-height:1.9
}

/* MARKET */
.markettabs{display:flex;gap:5px;overflow:auto;margin-bottom:13px}
.markettabs button{
 white-space:nowrap;background:#080a0a;border:1px solid #202727;
 color:#737d7a;padding:9px 12px
}

.marketgrid{
 display:grid;grid-template-columns:repeat(2,1fr);gap:12px
}

.item{
 border:1px solid #1b2222;background:#070909;overflow:hidden
}
.itemphoto{
 height:180px;position:relative;overflow:hidden;
 background:#101313
}

/* 가상 소품 "사진" */
.sugarphoto{
 background:
 radial-gradient(circle at 38% 45%,#eee 0 2px,transparent 3px),
 radial-gradient(circle at 55% 60%,#ddd 0 2px,transparent 3px),
 radial-gradient(circle at 63% 35%,#fff 0 2px,transparent 3px),
 linear-gradient(135deg,#1a1b1b,#050606)
}
.sugarphoto:after{
 content:"";position:absolute;width:125px;height:85px;
 left:50%;top:50%;transform:translate(-50%,-50%) rotate(-8deg);
 background:linear-gradient(145deg,#eee,#aaa);
 border:1px solid #777;
 box-shadow:0 15px 35px #000
}
.gunphoto{
 background:radial-gradient(circle,#292d2d,#050606 70%)
}
.gunphoto:after{
 content:"";position:absolute;width:180px;height:28px;
 background:linear-gradient(#252828,#080909);
 left:50%;top:50%;transform:translate(-50%,-50%) rotate(-12deg);
 box-shadow:45px 10px 0 -5px #111;
 border-radius:3px
}
.packagephoto{
 background:radial-gradient(circle at 50% 45%,#292d2c,#060707 70%)
}
.packagephoto:after{
 content:"";position:absolute;width:115px;height:125px;
 background:#bbb;left:50%;top:50%;transform:translate(-50%,-50%) rotate(5deg);
 box-shadow:0 20px 40px #000
}
.evidencephoto{
 background:
 repeating-linear-gradient(135deg,#161919 0 8px,#0a0c0c 9px 16px)
}
.evidencephoto:after{
 content:"████";position:absolute;color:#999;font-size:45px;
 left:50%;top:50%;transform:translate(-50%,-50%)
}

.photo-label{
 position:absolute;bottom:8px;left:9px;font-size:8px;
 color:#777;background:#050606;padding:4px
}

.itembody{padding:15px}
.itemname{color:#c3cbc8;font-size:13px}
.itemdesc{color:#535d5a;font-size:9px;line-height:1.7;margin-top:8px}
.meta{margin-top:10px;color:#78817e;font-size:9px}
.buy{width:100%;margin-top:11px}
.buy:hover{background:#ddd;color:#000}

/* ARCHIVE */
.archive{
 border-left:2px solid #303737;background:#070909;
 padding:14px;margin-bottom:10px
}
.archive small{color:#434c4a}
.archive p{font-size:11px;line-height:1.8;color:#8b9592}

/* RIGHT */
.track{font-size:10px;color:#555f5c;line-height:2}
.track span{color:#a1aaa7}
hr{border:0;border-top:1px solid #181f1f;margin:17px 0}

#toast{
 position:fixed;right:15px;bottom:15px;width:min(350px,calc(100% - 30px));
 z-index:5000
}
.toast{
 background:rgba(5,7,7,.97);border:1px solid #333b3a;
 color:#929b98;padding:12px;margin-top:6px;font-size:10px
}

@media(max-width:1000px){
 .layout{grid-template-columns:170px 1fr}
 .right{display:none}
}
@media(max-width:700px){
 header{padding:0 12px}
 .topstatus{display:none}
 .layout{display:block}
 aside{
  display:flex;overflow:auto;border-right:0;border-bottom:1px solid #181f1f;
  padding:5px
